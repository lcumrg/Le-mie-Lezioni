rules_version = '2';

// Regole di sicurezza per "Le mie Lezioni" — app single-user.
//
// L'unico vero confine di sicurezza di un'app Firebase client-only sono
// queste regole: il controllo email nel client (AuthContext) è solo UX,
// chiunque può chiamare l'SDK Firestore direttamente con un qualsiasi
// account Google. Qui l'accesso è consentito esclusivamente all'account
// del docente.
//
// IMPORTANTE: l'email qui sotto deve coincidere con VITE_AUTHORIZED_EMAIL
// nel file .env del deploy.
service cloud.firestore {
  match /databases/{database}/documents {

    function isDocente() {
      return request.auth != null
        && request.auth.token.email == 'lucamorigi@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // App single-user: tutte le collezioni (percorsi + subcollection unita,
    // assegnazioni, orari, lezioni, vacanze, config) appartengono al docente.
    // Il match ricorsivo copre anche eventuali collezioni future: restano
    // chiuse a chiunque altro per default.
    match /{document=**} {
      allow read, write: if isDocente();
    }
  }
}
